APP_NAME=POShoes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poshoes
DB_USERNAME=poshoes
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Queue / Cache / Scheduler ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
RECONNECT_ON_BROADCAST=true

# --- Mail (mailpit lokal) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=poshoes@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem / Object storage ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=poshoes
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=http://127.0.0.1:9000

# --- Laravel Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# --- WhatsApp Business Cloud API ---
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_PROVIDER=fake

# --- Error monitoring ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Horizon ---
HORIZON_PREFIX=poshoes

# --- Config khusus domain ---
# Bisnis
BUSINESS_NAME=POShoes
BUSINESS_ADDRESS=
BUSINESS_PHONE=

# Rule bisnis (ADR-0001)
STOCK_ALLOW_NEGATIVE=false
PAYMENT_REQUIRED_BEFORE_PICKUP=true
